# Market Risk VaR System - Environment Variables Template
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/market_risk_db
# Alternative: SQLite for development
# DATABASE_URL=sqlite:///./data/market_risk.db

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_WORKERS=4

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_CREDENTIALS=True

# API Keys (if needed for authentication)
API_SECRET_KEY=your-secret-key-here-change-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATA SOURCES
# =============================================================================
# Yahoo Finance (yfinance) - no API key needed by default
# If using premium data sources, add keys here
ALPHA_VANTAGE_API_KEY=
QUANDL_API_KEY=

# =============================================================================
# EMAIL ALERTS CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=True

# Alert Recipients (comma-separated)
ALERT_RECIPIENTS=risk-team@company.com,trader@company.com

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/market_risk.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# VAR CALCULATION DEFAULTS
# =============================================================================
DEFAULT_CONFIDENCE_LEVEL=0.95
DEFAULT_POSITION_VALUE=1000000
DEFAULT_HISTORICAL_WINDOW=252
DEFAULT_MC_SIMULATIONS=10000

# =============================================================================
# SCHEDULER CONFIGURATION
# =============================================================================
ENABLE_SCHEDULER=False
CALCULATION_SCHEDULE=09:00  # Daily VaR calculation time (HH:MM)
REPORT_SCHEDULE=17:00       # Daily report generation time
RETRAINING_SCHEDULE=SUNDAY  # Weekly model retraining

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# GARCH defaults
DEFAULT_GARCH_P=1
DEFAULT_GARCH_Q=1
DEFAULT_GARCH_DIST=normal

# ARIMA defaults
DEFAULT_ARIMA_P=2
DEFAULT_ARIMA_D=0
DEFAULT_ARIMA_Q=2

# ML Model settings
ML_MODEL_PATH=data/models/
ML_ENABLE_GPU=False
ML_BATCH_SIZE=32
ML_EPOCHS=100

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
STREAMLIT_PORT=8501

# =============================================================================
# DEVELOPMENT/PRODUCTION
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=True

# =============================================================================
# SECURITY
# =============================================================================
# JWT Secret for API authentication (generate strong random key)
JWT_SECRET_KEY=generate-strong-random-key-here
JWT_ALGORITHM=HS256

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
CACHE_ENABLED=True
CACHE_TTL=300  # seconds
MAX_WORKERS=4  # For parallel processing
